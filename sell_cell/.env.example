# Copy to .env (next to scrapy.cfg) and fill in.

# Zyte API key - every SellCell request goes through Zyte.
ZYTE_API_KEY=

# The analytics dashboard's product list, which says which products each run
# visits (Scraped / Custom script / Manual, set on the goselldevices admin).
# The full endpoint URL, e.g. https://dashboard.example.com/api/scraper/products
SCRAPER_API_URL=
# Must equal SCRAPER_API_SECRET in the dashboard's .env.
SCRAPER_API_SECRET=
